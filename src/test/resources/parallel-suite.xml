<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Parallel Suite" verbose="1" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.prasandeep.api.listeners.TestListener"/>
    </listeners>
    <test name="Parallel Posts">
        <classes>
            <class name="com.prasandeep.api.tests.GetPostTests"/>
            <class name="com.prasandeep.api.tests.MutatingPostTests"/>
        </classes>
    </test>
</suite>
